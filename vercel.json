{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/slack/commands",
      "destination": "/api/slack/commands"
    },
    {
      "source": "/github/webhook",
      "destination": "/api/github/webhook"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 300
    }
  }
}
